{
  "name": "mfl-backend",
  "version": "1.0.0",
  "description": "Master Flag League \u2014 API",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "migrate:prod": "node dist/db/migrate.js",
    "migrate": "tsx src/db/migrate.ts",
    "typecheck": "tsc --noEmit",
    "db:dev": "tsx scripts/dev-db.ts",
    "test": "node tests/integration.mjs",
    "test:cors": "node tests/cors.mjs",
    "test:fixture": "node tests/fixture.mjs",
    "test:competition": "node tests/competition.mjs",
    "test:finance": "node tests/finance.mjs",
    "test:edicion": "node tests/edicion.mjs",
    "test:storage": "node tests/almacenamiento.mjs",
    "test:bajas": "node tests/bajas.mjs",
    "test:esquema": "node tests/esquema.mjs",
    "test:recuperacion": "node tests/recuperacion.mjs",
    "test:publico": "node tests/publico.mjs",
    "test:all": "node tests/fixture.mjs && node tests/cors.mjs && node tests/integration.mjs && node tests/competition.mjs && node tests/finance.mjs && node tests/edicion.mjs && node tests/bajas.mjs && node tests/almacenamiento.mjs && node tests/recuperacion.mjs && node tests/publico.mjs && node tests/esquema.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@electric-sql/pglite-socket": "^0.2.11",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.4.1",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3"
  }
}
